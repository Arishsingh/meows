LIBSQL_URL=file:./app.db
LIBSQL_AUTH_TOKEN=
BETTER_AUTH_SECRET=change-me-32-bytes-random
# Base URL for Better Auth. On Vercel the orchestrator pre-wires this to the
# predicted prod URL (https://<slug>.vercel.app) before the first deploy, and
# lib/auth.ts also trusts VERCEL_URL / VERCEL_BRANCH_URL / VERCEL_PROJECT_PRODUCTION_URL
# at runtime, so sign-in works on every hostname Vercel exposes. Override only
# when you attach a custom domain or put this behind a reverse proxy.
# BETTER_AUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only AI provider keys. The generated app tries providers in
# AI_PROVIDER_ORDER and defaults to free/low-cost routes first.
AI_PROVIDER_ORDER=openrouter,huggingface,openai
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REFERER=
OPENROUTER_TITLE=
HF_TOKEN=
HF_BASE_URL=https://router.huggingface.co/v1
HF_MODEL=deepseek-ai/DeepSeek-R1:fastest
HF_BILL_TO=
OPENAI_API_KEY=
