  "workflows": [
    {
      "name": "Add a site",
      "steps": [
        "Enter the deployed site name and base URL",
        "Save the site",
        "Optionally upload a brand image"
      ]
    },
    {
      "name": "Run an audit",
      "steps": [
        "Start a scan from the site detail page",
        "Crawl public routes",
        "Generate a score, page checks, and findings"
      ]
    },
    {
      "name": "Review issues",
      "steps": [
        "Open an audit run",
        "Inspect missing metadata, canonical, robots, sitemap, and schema checks",
        "Read fix recommendations for each page"
      ]
    },
    {
      "name": "Track progress",
      "steps": [
        "Mark findings resolved after deploying fixes",
        "Rerun the audit",
        "Compare the new score and issue list with the prior run"
      ]
    }
  ],
  "primaryWorkflow": "Add a deployed site and run its first audit to see the full SEO report.",
  "acceptanceChecks": [
    "User can create a Site with a deployed base URL and see it listed in the dashboard.",
    "User can start an AuditRun and receive a score plus page-level checks and findings.",
    "Audit detail pages surface distinct checks for title, meta description, Open Graph, Twitter card, canonical URL, robots, sitemap coverage, and JSON-LD.",
    "User can upload a BrandAsset and attach it to a Site.",
    "Running a new audit creates a separate history entry without overwriting prior results."
  ],
