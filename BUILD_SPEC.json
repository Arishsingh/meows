{
  "name": "Rankly",
  "slug": "rankly",
  "tagline": "Find and fix the SEO gaps that keep your deployed app from ranking.",
  "positioning": "Rankly is a lightweight SEO audit workspace for deployed marketing sites, portfolios, and Next.js apps. It scans public routes for titles, meta descriptions, Open Graph and Twitter tags, canonical URLs, robots directives, sitemap coverage, and JSON-LD, then turns the results into page-level findings and fix history so a solo builder or small team can tighten search visibility without redesigning the product.",
  "archetype": "web-app",
  "kind": "fullstack",
  "features": {
    "auth": true,
    "payments": false
  },
  "entities": [
    {
      "name": "Site",
      "description": "A deployed app or marketing site being monitored for SEO health.",
      "ownedByUser": true,
